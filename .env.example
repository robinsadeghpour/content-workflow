# Anthropic API key — used by writing/humanizer skills and content generation.
# Claude Code itself uses your CLI auth; this is only needed if scripts call the SDK directly.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Apify token: used by Pulse and X audience research.
# Pulse skips Apify sources when unset. Audience research stops with an error.
APIFY_TOKEN=your_apify_token_here

# Optional Pulse X Actor route.
# Keep the existing default or select xquik/x-tweet-scraper.
PULSE_X_ACTOR_ID=apidojo/tweet-scraper

# Optional maximum total charge for each Apify Actor run.
# Set a positive USD amount. Leave blank to use your Apify account settings.
APIFY_MAX_TOTAL_CHARGE_USD=

# Supadata API key — used for YouTube/TikTok/Instagram transcript extraction during pulse.
# Optional: transcript-fetcher will skip if unset.
# Sign up: https://supadata.ai/?ref=robin
SUPADATA_API_KEY=your_supadata_api_key_here

# Gemini API key — used by nano-banana skill for fallback AI image generation.
# Optional: only invoked when no real visual is available for a slide.
GEMINI_API_KEY=your_gemini_api_key_here

# Postiz API key — used by the postiz skill to schedule/publish posts and pull analytics.
# Required if you want /approve to actually schedule.
# Sign up: https://postiz.pro/robin-sadeghpour-faraj
# API docs: https://docs.postiz.com/public-api
POSTIZ_API_KEY=your_postiz_api_key_here
